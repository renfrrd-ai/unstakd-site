{
  // Static site: `next build` exports plain files to out/ (output: "export"),
  // so this is an assets-only Worker — no OpenNext, no server code.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unstakd-site",
  "compatibility_date": "2026-11-19",
  "assets": {
    "directory": "./out",
    // /docs serves docs.html; unknown paths get out/404.html with a 404 status.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true }
}
